# The local Docker Compose demo works without this file. Never commit real credentials.

# Core application behaviour
CLOUDCOST_DEMO_MODE=true
CLOUDCOST_ALLOW_LIVE_SYNC=false
CLOUDCOST_DATABASE_URL=postgresql+psycopg://cloudcost:cloudcost_local_only@localhost:5432/cloudcost
CLOUDCOST_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# AWS Cost Explorer - keep disabled until a read-only billing role is configured.
CLOUDCOST_AWS_COST_EXPLORER_ENABLED=false
CLOUDCOST_AWS_REGION=us-east-1
# CLOUDCOST_AWS_COST_EXPLORER_ROLE_ARN=arn:aws:iam::<account-id>:role/CloudCostReadOnly

# Azure Cost Management - keep disabled until a read-only service principal is configured.
CLOUDCOST_AZURE_COST_MANAGEMENT_ENABLED=false
# CLOUDCOST_AZURE_SUBSCRIPTION_ID=
# CLOUDCOST_AZURE_TENANT_ID=
# CLOUDCOST_AZURE_CLIENT_ID=
# CLOUDCOST_AZURE_CLIENT_SECRET=
